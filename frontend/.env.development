# Config OIDC para desarrollo (Vite en http://localhost:3000). Keycloak corre en el compose (8180).
# El authority es el emisor PUBLICO: coincide con el 'iss' que validan los 3 servicios.
VITE_KEYCLOAK_AUTHORITY=http://localhost:8180/realms/hexabank
VITE_KEYCLOAK_CLIENT_ID=hexabank-frontend
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:3000
