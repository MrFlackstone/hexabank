<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hexabank</groupId>
    <artifactId>hexabank-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>HexaBank Parent</name>
    <description>
        Monorepo padre de HexaBank: demo de microservicios hexagonales con saga Kafka.
        Gestiona versiones de forma centralizada (Java 21 + BOM de Spring Boot 3.x).
        Los servicios se anaden como modulos en sus respectivas fases.
    </description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!--
        No heredamos de spring-boot-starter-parent. En su lugar importamos el BOM
        spring-boot-dependencies en <dependencyManagement>. Asi 'shared-events' (modulo
        Java puro, sin Spring) no arrastra el plugin de empaquetado fat-jar; cada servicio
        declarara spring-boot-maven-plugin cuando lo necesite.
    -->

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- Bucket4j (rate limiting, Fase 11): no esta en el BOM de Spring Boot -> version explicita. -->
        <bucket4j.version>8.19.0</bucket4j.version>
        <!-- Spring Cloud (Fase 13b, contract testing): train 2025.0.x alineado a Boot 3.5. -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!--
            Version del spring-cloud-contract-maven-plugin (las librerias las fija el BOM de Spring Cloud).
            4.3.3+ rompe la primera build con el repo local vacio (ClassCastException en el transporte HTTP
            de Maven al cargarse la extension del plugin) -> se queda en 4.3.1, ultima que resuelve bien.
        -->
        <spring-cloud-contract.version>4.3.1</spring-cloud-contract.version>
        <!--
            Overrides de seguridad sobre el BOM de Boot 3.5.16 (ultima 3.5.x OSS): parches de la misma
            linea menor con CVEs publicados despues de esa release. Revisar/eliminar al migrar de Boot.
        -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <tomcat.version>10.1.61</tomcat.version>
        <postgresql.version>42.7.14</postgresql.version>
        <lz4-java.version>1.11.4</lz4-java.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
    </properties>

    <modules>
        <module>shared-events</module>
        <module>account-service</module>
        <module>transfer-service</module>
        <module>ledger-service</module>
        <module>e2e-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!--
                BOM de Jackson ANTES que el de Boot: entre BOMs importados gana el primero declarado.
                CVE-2026-89425/89407 (jackson-core) y CVE-2026-91776/91777/68497 (jackson-databind).
            -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- BOM de Spring Boot: fija versiones de todas las dependencias gestionadas -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- BOM de Spring Cloud (Fase 13b): gestiona Spring Cloud Contract (verifier + stub-runner). -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Rate limiting por token-bucket (Fase 11). Variante jdk17-core: en memoria, sin cluster. -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <!-- Tomcat embebido: CVE-2026-65905/65182/68525 (bypass de autenticacion/autorizacion). -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <!-- Driver JDBC: CVE-2026-54291 (downgrade silencioso del channel binding SCRAM). -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <!-- Transitiva de kafka-clients: CVE-2026-106451 y otros DoS en la descompresion LZ4. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <!--
                CVE-2025-48924 (recursion sin limite en ClassUtils.getClass): el BOM de Boot 3.5.x fija
                3.17.0; llega transitiva via springdoc y spring-cloud-contract.
            -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!--
                            Conserva los nombres de los parametros en el bytecode. Spring lo necesita
                            para resolver @PathVariable/@RequestParam por nombre. spring-boot-starter-parent
                            lo activa por defecto; como importamos el BOM en su lugar, lo activamos aqui.
                        -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <!--
                    Fija la version del plugin de Spring Boot a la del BOM. Sin esto, Maven resuelve
                    la ULTIMA disponible (p. ej. 4.1.0), incompatible con el runtime 3.5.x.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
